<Window x:Class="Vanta.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Vanta" Width="804" Height="203"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        WindowStyle="None" Background="{StaticResource BackgroundBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="49" ResizeBorderThickness="0" CornerRadius="10" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="#85878A" BorderThickness="2" CornerRadius="10" Background="#000000">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="49" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource HeaderBrush}" BorderBrush="#343438" BorderThickness="0,0,0,2" CornerRadius="10,10,0,0">
                <Grid Margin="12,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Image Grid.Column="0" Source="Assets/Vanta Logo.png" Width="30" Height="30" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center" SnapsToDevicePixels="True" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <RadioButton x:Name="HomeNav" GroupName="Navigation" Style="{StaticResource NavButton}" Content="&#xE80F;" IsChecked="True" Click="HomeNav_Click" />
                        <RadioButton x:Name="AdvancedNav" GroupName="Navigation" Style="{StaticResource NavButton}" Content="&#xE81E;" Margin="7,0" Click="AdvancedNav_Click" />
                        <RadioButton x:Name="SettingsNav" GroupName="Navigation" Style="{StaticResource NavButton}" Content="&#xE713;" Click="SettingsNav_Click" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button x:Name="PinButton" Style="{StaticResource HeaderButton}" Click="PinButton_Click">
                            <TextBlock x:Name="PinIcon" Text="&#xE718;" FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="#F1F1F2" />
                        </Button>
                        <Button Style="{StaticResource HeaderButton}" Click="MinimizeButton_Click">
                            <TextBlock Text="&#xE921;" FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="#F1F1F2" />
                        </Button>
                        <Button Style="{StaticResource HeaderButton}" Click="CloseButton_Click">
                            <TextBlock Text="&#xE8BB;" FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="#F1F1F2" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid x:Name="HomeView" Grid.Row="1" Height="50" Margin="29,0" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="215" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="190" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource HomeControl}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDropDownOpen, ElementName=CadenceUnitCombo}" Value="True">
                                    <Setter Property="CornerRadius" Value="9,9,0,9" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="57" />
                            <ColumnDefinition Width="2" />
                            <ColumnDefinition Width="126" />
                            <ColumnDefinition Width="2" />
                            <ColumnDefinition Width="113" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="CadenceValueBox" Grid.Column="0" Text="10" PreviewTextInput="NumberOnly_PreviewTextInput" TextChanged="Setting_Changed" />
                        <Border Grid.Column="1" Style="{StaticResource Divider}" />
                        <TextBlock Grid.Column="2" Text="Clicks Per" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Border Grid.Column="3" Style="{StaticResource Divider}" />
                        <ComboBox x:Name="CadenceUnitCombo" Grid.Column="4" Style="{StaticResource InlineCombo}" FontSize="15" SelectionChanged="Setting_Changed">
                            <ComboBoxItem Content="ms" Tag="Millisecond" />
                            <ComboBoxItem Content="s" Tag="Second" IsSelected="True" />
                            <ComboBoxItem Content="m" Tag="Minute" />
                            <ComboBoxItem Content="h" Tag="Hour" />
                        </ComboBox>
                    </Grid>
                </Border>

                <Border Grid.Column="2">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource HomeControl}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDropDownOpen, ElementName=ActivationCombo}" Value="True">
                                    <Setter Property="CornerRadius" Value="9,9,0,9" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="127" />
                            <ColumnDefinition Width="2" />
                            <ColumnDefinition Width="86" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="HotkeyInputBox" Grid.Column="0" Style="{StaticResource HotkeyCapture}" Text="Alt + Q" IsReadOnly="True" IsReadOnlyCaretVisible="False" PreviewKeyDown="HotkeyInputBox_PreviewKeyDown" GotKeyboardFocus="HotkeyInputBox_GotKeyboardFocus" LostKeyboardFocus="HotkeyInputBox_LostKeyboardFocus" />
                        <Border Grid.Column="1" Style="{StaticResource Divider}" />
                        <ComboBox x:Name="ActivationCombo" Grid.Column="2" Style="{StaticResource InlineCombo}" SelectionChanged="Setting_Changed">
                            <ComboBoxItem Content="Toggle" Tag="Toggle" IsSelected="True" />
                            <ComboBoxItem Content="Hold" Tag="Hold" />
                        </ComboBox>
                    </Grid>
                </Border>

                <Border Grid.Column="4">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource HomeControl}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDropDownOpen, ElementName=MouseButtonCombo}" Value="True">
                                    <Setter Property="CornerRadius" Value="9,9,0,9" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="99" />
                            <ColumnDefinition Width="2" />
                            <ColumnDefinition Width="89" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ClickerTypeLabel" Grid.Column="0" Text="Mouse" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Border Grid.Column="1" Style="{StaticResource Divider}" />
                        <ComboBox x:Name="MouseButtonCombo" Grid.Column="2" Style="{StaticResource InlineCombo}" SelectionChanged="Setting_Changed">
                            <ComboBoxItem Content="Left" Tag="Left" IsSelected="True" />
                            <ComboBoxItem Content="Middle" Tag="Middle" />
                            <ComboBoxItem Content="Right" Tag="Right" />
                        </ComboBox>
                        <TextBox x:Name="KeyboardTargetBox" Grid.Column="2" Text="Space" Visibility="Collapsed" IsReadOnly="True" IsReadOnlyCaretVisible="False" Cursor="Hand" FontSize="15" PreviewKeyDown="KeyboardTarget_PreviewKeyDown" GotKeyboardFocus="KeyboardTarget_GotKeyboardFocus" LostKeyboardFocus="KeyboardTarget_LostKeyboardFocus" />
                    </Grid>
                </Border>
            </Grid>

            <Grid x:Name="AdvancedView" Grid.Row="1" Margin="20,12" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="9" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="9" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource AdvancedCard}">
                    <Grid Margin="12,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="40" />
                            <RowDefinition Height="1" />
                            <RowDefinition Height="26" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource AdvancedTitle}" Text="Click Speed" />
                            </StackPanel>
                            <Border Width="140" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource AdvancedSegmentShell}">
                                <UniformGrid Columns="2">
                                    <RadioButton x:Name="AdvancedRateMode" GroupName="CadenceMode" Style="{StaticResource AdvancedSegment}" Tag="Left" Content="Rate" IsChecked="True" Checked="AdvancedSetting_Changed" />
                                    <RadioButton x:Name="AdvancedDelayMode" GroupName="CadenceMode" Style="{StaticResource AdvancedSegment}" Tag="Right" Content="Interval" Checked="AdvancedSetting_Changed" />
                                </UniformGrid>
                            </Border>
                        </Grid>
                        <Border Grid.Row="1" Background="#29292D" />
                        <TextBlock Grid.Row="2" Style="{StaticResource AdvancedDescription}" Text="Changes how fast the auto clicker clicks." />
                        <Grid Grid.Row="3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="5" />
                                <ColumnDefinition Width="42" />
                                <ColumnDefinition Width="5" />
                                <ColumnDefinition Width="92" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="AdvancedCadenceValueBox" Style="{StaticResource AdvancedField}" Text="10" HorizontalContentAlignment="Center" Padding="3,0" PreviewTextInput="NumberOnly_PreviewTextInput" TextChanged="AdvancedSetting_Changed" />
                            <TextBlock Grid.Column="2" Text="Clicks Per" Foreground="#AFAFB4" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <TextBox x:Name="AdvancedPeriodValueBox" Grid.Column="4" Style="{StaticResource AdvancedField}" Text="1" HorizontalContentAlignment="Center" Padding="3,0" PreviewTextInput="NumberOnly_PreviewTextInput" TextChanged="AdvancedSetting_Changed" />
                            <Border Grid.Column="6" Style="{StaticResource AdvancedSegmentShell}">
                                <ComboBox x:Name="AdvancedCadenceUnitCombo" Style="{StaticResource InlineCombo}" FontSize="13" SelectionChanged="AdvancedSetting_Changed">
                                    <ComboBoxItem Content="ms" Tag="Millisecond" />
                                    <ComboBoxItem Content="s" Tag="Second" IsSelected="True" />
                                    <ComboBoxItem Content="m" Tag="Minute" />
                                    <ComboBoxItem Content="h" Tag="Hour" />
                                </ComboBox>
                            </Border>
                            <TextBlock x:Name="AdvancedIntervalText" Grid.Column="7" Text="100ms interval" Margin="7,0,0,0" Foreground="#8F939B" FontSize="10" VerticalAlignment="Center" />
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource AdvancedCard}">
                    <Grid Margin="12,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="40" />
                            <RowDefinition Height="1" />
                            <RowDefinition Height="26" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource AdvancedTitle}" Text="Hotkey" />
                            </StackPanel>
                            <Border Width="134" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource AdvancedSegmentShell}">
                                <UniformGrid Columns="2">
                                    <RadioButton x:Name="AdvancedToggleMode" GroupName="ActivationMode" Style="{StaticResource AdvancedSegment}" Tag="Left" Content="Toggle" IsChecked="True" Checked="AdvancedSetting_Changed" />
                                    <RadioButton x:Name="AdvancedHoldMode" GroupName="ActivationMode" Style="{StaticResource AdvancedSegment}" Tag="Right" Content="Hold" Checked="AdvancedSetting_Changed" />
                                </UniformGrid>
                            </Border>
                        </Grid>
                        <Border Grid.Row="1" Background="#29292D" />
                        <TextBlock Grid.Row="2" Style="{StaticResource AdvancedDescription}" Text="Press the hotkey to turn the clicker on and off." />
                        <Grid Grid.Row="3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="112" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="AdvancedHotkeyInputBox" Style="{StaticResource AdvancedField}" Text="Alt + Q" IsReadOnly="True" IsReadOnlyCaretVisible="False" PreviewKeyDown="HotkeyInputBox_PreviewKeyDown" GotKeyboardFocus="HotkeyInputBox_GotKeyboardFocus" LostKeyboardFocus="HotkeyInputBox_LostKeyboardFocus" />
                            <Button Grid.Column="2" Style="{StaticResource AdvancedAction}" Content="Edit Hotkey" Click="EditHotkey_Click" />
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource AdvancedCard}">
                    <Grid Margin="12,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="40" />
                            <RowDefinition Height="1" />
                            <RowDefinition Height="26" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource AdvancedTitle}" Text="Clicker Type" />
                            </StackPanel>
                            <Border Width="154" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource AdvancedSegmentShell}">
                                <UniformGrid Columns="2">
                                    <RadioButton x:Name="AdvancedMouseType" GroupName="ClickerType" Style="{StaticResource AdvancedSegment}" Tag="Left" Content="Mouse" IsChecked="True" Checked="AdvancedSetting_Changed" />
                                    <RadioButton x:Name="AdvancedKeyboardType" GroupName="ClickerType" Style="{StaticResource AdvancedSegment}" Tag="Right" Content="Keyboard" Checked="AdvancedSetting_Changed" />
                                </UniformGrid>
                            </Border>
                        </Grid>
                        <Border Grid.Row="1" Background="#29292D" />
                        <TextBlock x:Name="AdvancedClickerDescription" Grid.Row="2" Style="{StaticResource AdvancedDescription}" Text="Select the mouse button the auto clicker clicks." />
                        <Grid x:Name="AdvancedMouseOptions" Grid.Row="3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="82" />
                                <ColumnDefinition Width="86" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Double Click" Foreground="#BFC0C5" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Border Grid.Column="1" Style="{StaticResource AdvancedSegmentShell}">
                                <UniformGrid Columns="2">
                                    <RadioButton x:Name="AdvancedDoubleOff" GroupName="DoubleClickEnabled" Style="{StaticResource AdvancedSegment}" Tag="Left" Content="Off" IsChecked="True" Checked="AdvancedSetting_Changed" />
                                    <RadioButton x:Name="AdvancedDoubleOn" GroupName="DoubleClickEnabled" Style="{StaticResource AdvancedSegment}" Tag="Right" Content="On" Checked="AdvancedSetting_Changed" />
                                </UniformGrid>
                            </Border>
                            <Border Grid.Column="3" Style="{StaticResource AdvancedSegmentShell}">
                                <UniformGrid Columns="3">
                                    <RadioButton x:Name="AdvancedMouseLeft" GroupName="MouseButton" Style="{StaticResource AdvancedSegment}" Tag="Left" Content="Left" IsChecked="True" Checked="AdvancedSetting_Changed" />
                                    <RadioButton x:Name="AdvancedMouseMiddle" GroupName="MouseButton" Style="{StaticResource AdvancedSegment}" Content="Middle" Checked="AdvancedSetting_Changed" />
                                    <RadioButton x:Name="AdvancedMouseRight" GroupName="MouseButton" Style="{StaticResource AdvancedSegment}" Tag="Right" Content="Right" Checked="AdvancedSetting_Changed" />
                                </UniformGrid>
                            </Border>
                        </Grid>
                        <Grid x:Name="AdvancedKeyboardOptions" Grid.Row="3" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="102" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Key" Foreground="#BFC0C5" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBox x:Name="AdvancedKeyboardKeyBox" Grid.Column="1" Style="{StaticResource AdvancedField}" Text="Space" IsReadOnly="True" IsReadOnlyCaretVisible="False" Cursor="Hand" PreviewKeyDown="KeyboardTarget_PreviewKeyDown" GotKeyboardFocus="KeyboardTarget_GotKeyboardFocus" LostKeyboardFocus="KeyboardTarget_LostKeyboardFocus" />
                            <Button Grid.Column="3" Style="{StaticResource AdvancedAction}" Content="Edit Key" Click="EditKeyboardKey_Click" />
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource AdvancedCard}">
                    <Grid Margin="12,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="40" />
                            <RowDefinition Height="1" />
                            <RowDefinition Height="26" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource AdvancedTitle}" Text="Limits" />
                            </StackPanel>
                            <Border Width="86" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource AdvancedSegmentShell}">
                                <UniformGrid Columns="2">
                                    <RadioButton x:Name="AdvancedLimitOff" GroupName="LimitEnabled" Style="{StaticResource AdvancedSegment}" Tag="Left" Content="Off" IsChecked="True" Checked="AdvancedSetting_Changed" />
                                    <RadioButton x:Name="AdvancedLimitOn" GroupName="LimitEnabled" Style="{StaticResource AdvancedSegment}" Tag="Right" Content="On" Checked="AdvancedSetting_Changed" />
                                </UniformGrid>
                            </Border>
                        </Grid>
                        <Border Grid.Row="1" Background="#29292D" />
                        <TextBlock Grid.Row="2" Style="{StaticResource AdvancedDescription}" Text="Stop automatically after a set number of clicks or time." />
                        <Grid Grid.Row="3" IsEnabled="{Binding IsChecked, ElementName=AdvancedLimitOn}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="122" />
                            </Grid.ColumnDefinitions>
                            <Grid>
                                <TextBox x:Name="AdvancedLimitValueBox" Style="{StaticResource AdvancedField}" Text="1000" Padding="10,0,62,0" HorizontalContentAlignment="Right" PreviewTextInput="IntegerOnly_PreviewTextInput" TextChanged="AdvancedSetting_Changed" />
                                <TextBlock x:Name="AdvancedLimitSuffix" Text="clicks" Margin="0,0,12,0" Foreground="#8F939B" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" IsHitTestVisible="False" />
                            </Grid>
                            <Border Grid.Column="2" Style="{StaticResource AdvancedSegmentShell}">
                                <UniformGrid Columns="2">
                                    <RadioButton x:Name="AdvancedLimitClicks" GroupName="LimitType" Style="{StaticResource AdvancedSegment}" Tag="Left" Content="Click" IsChecked="True" Checked="AdvancedSetting_Changed" />
                                    <RadioButton x:Name="AdvancedLimitTime" GroupName="LimitType" Style="{StaticResource AdvancedSegment}" Tag="Right" Content="Time" Checked="AdvancedSetting_Changed" />
                                </UniformGrid>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Row="4" Grid.Column="0" Style="{StaticResource AdvancedCard}">
                    <Grid Margin="12,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="40" />
                            <RowDefinition Height="1" />
                            <RowDefinition Height="26" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource AdvancedTitle}" Text="Duty Cycle" />
                            </StackPanel>
                            <Border Width="120" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource AdvancedSegmentShell}">
                                <UniformGrid Columns="2">
                                    <RadioButton x:Name="AdvancedDutyClickMode" GroupName="DutyCycleMode" Style="{StaticResource AdvancedSegment}" Tag="Left" Content="Click" IsChecked="True" Checked="AdvancedSetting_Changed" />
                                    <RadioButton x:Name="AdvancedDutyHoldMode" GroupName="DutyCycleMode" Style="{StaticResource AdvancedSegment}" Tag="Right" Content="Hold" Checked="AdvancedSetting_Changed" />
                                </UniformGrid>
                            </Border>
                        </Grid>
                        <Border Grid.Row="1" Background="#29292D" />
                        <TextBlock Grid.Row="2" Style="{StaticResource AdvancedDescription}" Text="Controls how long the button is held during each click." />
                        <Grid Grid.Row="3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="96" />
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="1">
                                <TextBox x:Name="AdvancedClickDurationBox" Style="{StaticResource AdvancedField}" Text="15" Padding="8,0,22,0" PreviewTextInput="NumberOnly_PreviewTextInput" TextChanged="AdvancedSetting_Changed" />
                                <TextBlock Text="%" Margin="0,0,10,0" Foreground="#AFAFB4" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" IsHitTestVisible="False" />
                            </Grid>
                            <TextBlock Grid.Column="2" Text="hold duration" Margin="9,0,0,0" Foreground="#8F939B" FontSize="11" VerticalAlignment="Center" />
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Row="4" Grid.Column="2" Style="{StaticResource AdvancedCard}">
                    <Grid Margin="12,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="40" />
                            <RowDefinition Height="1" />
                            <RowDefinition Height="26" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource AdvancedTitle}" Text="Speed Randomization" />
                            </StackPanel>
                            <Border Width="86" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource AdvancedSegmentShell}">
                                <UniformGrid Columns="2">
                                    <RadioButton x:Name="AdvancedVariationOff" GroupName="VariationEnabled" Style="{StaticResource AdvancedSegment}" Tag="Left" Content="Off" IsChecked="True" Checked="AdvancedSetting_Changed" />
                                    <RadioButton x:Name="AdvancedVariationOn" GroupName="VariationEnabled" Style="{StaticResource AdvancedSegment}" Tag="Right" Content="On" Checked="AdvancedSetting_Changed" />
                                </UniformGrid>
                            </Border>
                        </Grid>
                        <Border Grid.Row="1" Background="#29292D" />
                        <TextBlock Grid.Row="2" Style="{StaticResource AdvancedDescription}" Text="Randomizes your click speed by the given percentage." />
                        <Grid Grid.Row="3" IsEnabled="{Binding IsChecked, ElementName=AdvancedVariationOn}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="96" />
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="1">
                                <TextBox x:Name="AdvancedVariationBox" Style="{StaticResource AdvancedField}" Text="10" Padding="8,0,22,0" PreviewTextInput="NumberOnly_PreviewTextInput" TextChanged="AdvancedSetting_Changed" />
                                <TextBlock Text="%" Margin="0,0,10,0" Foreground="#AFAFB4" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" IsHitTestVisible="False" />
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
            <Grid x:Name="SettingsView" Grid.Row="1" Visibility="Collapsed" />
        </Grid>
    </Border>
</Window>
