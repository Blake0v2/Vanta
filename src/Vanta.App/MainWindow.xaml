<Window x:Class="Vanta.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Vanta" Width="804" Height="203"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        WindowStyle="None" Background="{StaticResource BackgroundBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="49" ResizeBorderThickness="0" CornerRadius="10" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="#85878A" BorderThickness="2" CornerRadius="10" Background="#000000">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="49" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource HeaderBrush}" BorderBrush="#343438" BorderThickness="0,0,0,2" CornerRadius="10,10,0,0">
                <Grid Margin="12,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Image Grid.Column="0" Source="Assets/Vanta Logo.png" Width="30" Height="30" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center" SnapsToDevicePixels="True" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <RadioButton x:Name="HomeNav" GroupName="Navigation" Style="{StaticResource NavButton}" Content="&#xE80F;" IsChecked="True" Click="HomeNav_Click" />
                        <RadioButton x:Name="AdvancedNav" GroupName="Navigation" Style="{StaticResource NavButton}" Content="&#xE81E;" Margin="7,0" Click="AdvancedNav_Click" />
                        <RadioButton x:Name="SettingsNav" GroupName="Navigation" Style="{StaticResource NavButton}" Content="&#xE713;" Click="SettingsNav_Click" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button x:Name="PinButton" Style="{StaticResource HeaderButton}" Click="PinButton_Click">
                            <TextBlock x:Name="PinIcon" Text="&#xE718;" FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="#F1F1F2" />
                        </Button>
                        <Button Style="{StaticResource HeaderButton}" Click="MinimizeButton_Click">
                            <TextBlock Text="&#xE921;" FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="#F1F1F2" />
                        </Button>
                        <Button Style="{StaticResource HeaderButton}" Click="CloseButton_Click">
                            <TextBlock Text="&#xE8BB;" FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="#F1F1F2" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid x:Name="HomeView" Grid.Row="1" Height="50" Margin="29,0" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="215" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="190" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource HomeControl}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDropDownOpen, ElementName=CadenceUnitCombo}" Value="True">
                                    <Setter Property="CornerRadius" Value="9,9,0,9" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="57" />
                            <ColumnDefinition Width="2" />
                            <ColumnDefinition Width="126" />
                            <ColumnDefinition Width="2" />
                            <ColumnDefinition Width="113" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="CadenceValueBox" Grid.Column="0" Text="10" PreviewTextInput="NumberOnly_PreviewTextInput" TextChanged="Setting_Changed" />
                        <Border Grid.Column="1" Style="{StaticResource Divider}" />
                        <TextBlock Grid.Column="2" Text="Clicks Per" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Border Grid.Column="3" Style="{StaticResource Divider}" />
                        <ComboBox x:Name="CadenceUnitCombo" Grid.Column="4" Style="{StaticResource InlineCombo}" FontSize="15" SelectionChanged="Setting_Changed">
                            <ComboBoxItem Content="ms" Tag="Millisecond" />
                            <ComboBoxItem Content="s" Tag="Second" IsSelected="True" />
                            <ComboBoxItem Content="m" Tag="Minute" />
                            <ComboBoxItem Content="h" Tag="Hour" />
                        </ComboBox>
                    </Grid>
                </Border>

                <Border Grid.Column="2">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource HomeControl}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDropDownOpen, ElementName=ActivationCombo}" Value="True">
                                    <Setter Property="CornerRadius" Value="9,9,0,9" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="127" />
                            <ColumnDefinition Width="2" />
                            <ColumnDefinition Width="86" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="HotkeyInputBox" Grid.Column="0" Style="{StaticResource HotkeyCapture}" Text="Alt + Q" IsReadOnly="True" IsReadOnlyCaretVisible="False" PreviewKeyDown="HotkeyInputBox_PreviewKeyDown" GotKeyboardFocus="HotkeyInputBox_GotKeyboardFocus" LostKeyboardFocus="HotkeyInputBox_LostKeyboardFocus" />
                        <Border Grid.Column="1" Style="{StaticResource Divider}" />
                        <ComboBox x:Name="ActivationCombo" Grid.Column="2" Style="{StaticResource InlineCombo}" SelectionChanged="Setting_Changed">
                            <ComboBoxItem Content="Toggle" Tag="Toggle" IsSelected="True" />
                            <ComboBoxItem Content="Hold" Tag="Hold" />
                        </ComboBox>
                    </Grid>
                </Border>

                <Border Grid.Column="4">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource HomeControl}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDropDownOpen, ElementName=MouseButtonCombo}" Value="True">
                                    <Setter Property="CornerRadius" Value="9,9,0,9" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="99" />
                            <ColumnDefinition Width="2" />
                            <ColumnDefinition Width="89" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Mouse" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Border Grid.Column="1" Style="{StaticResource Divider}" />
                        <ComboBox x:Name="MouseButtonCombo" Grid.Column="2" Style="{StaticResource InlineCombo}" SelectionChanged="Setting_Changed">
                            <ComboBoxItem Content="Left" Tag="Left" IsSelected="True" />
                            <ComboBoxItem Content="Middle" Tag="Middle" />
                            <ComboBoxItem Content="Right" Tag="Right" />
                        </ComboBox>
                    </Grid>
                </Border>
            </Grid>

            <Grid x:Name="AdvancedView" Grid.Row="1" Margin="18,12,18,13" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="398" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="406" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <Border Height="166" Style="{StaticResource AdvancedCard}">
                        <Grid Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="22" />
                                <RowDefinition Height="4" />
                                <RowDefinition Height="34" />
                                <RowDefinition Height="4" />
                                <RowDefinition Height="34" />
                                <RowDefinition Height="4" />
                                <RowDefinition Height="34" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="78" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal">
                                <TextBlock Text="Cadence" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>

                            <TextBlock Grid.Row="2" Text="Rate" Foreground="#BFC0C5" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Grid Grid.Row="2" Grid.Column="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="52" />
                                    <ColumnDefinition Width="66" />
                                    <ColumnDefinition Width="92" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="78" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="AdvancedCadenceValueBox" Grid.Column="0" Style="{StaticResource AdvancedField}" Text="10" HorizontalContentAlignment="Center" Padding="3,0" PreviewTextInput="NumberOnly_PreviewTextInput" TextChanged="AdvancedSetting_Changed" />
                                <TextBlock Grid.Column="1" Text="Clicks Per" Foreground="#AFAFB4" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Border Grid.Column="2" Style="{StaticResource AdvancedSegmentShell}">
                                    <ComboBox x:Name="AdvancedCadenceUnitCombo" Style="{StaticResource InlineCombo}" FontSize="13" SelectionChanged="AdvancedSetting_Changed">
                                        <ComboBoxItem Content="ms" Tag="Millisecond" />
                                        <ComboBoxItem Content="s" Tag="Second" IsSelected="True" />
                                        <ComboBoxItem Content="m" Tag="Minute" />
                                        <ComboBoxItem Content="h" Tag="Hour" />
                                    </ComboBox>
                                </Border>
                                <Border Grid.Column="4" Style="{StaticResource AdvancedSegmentShell}">
                                    <UniformGrid Columns="2">
                                        <RadioButton x:Name="AdvancedRateMode" GroupName="CadenceMode" Style="{StaticResource AdvancedSegment}" Content="Rate" IsChecked="True" Checked="AdvancedSetting_Changed" />
                                        <RadioButton x:Name="AdvancedDelayMode" GroupName="CadenceMode" Style="{StaticResource AdvancedSegment}" Content="Delay" Checked="AdvancedSetting_Changed" />
                                    </UniformGrid>
                                </Border>
                            </Grid>

                            <TextBlock Grid.Row="4" Text="Hotkey" Foreground="#BFC0C5" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Grid Grid.Row="4" Grid.Column="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="144" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="144" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="AdvancedHotkeyInputBox" Grid.Column="0" Style="{StaticResource AdvancedField}" Text="Alt + Q" IsReadOnly="True" IsReadOnlyCaretVisible="False" HorizontalContentAlignment="Center" PreviewKeyDown="HotkeyInputBox_PreviewKeyDown" GotKeyboardFocus="HotkeyInputBox_GotKeyboardFocus" LostKeyboardFocus="HotkeyInputBox_LostKeyboardFocus" />
                                <Border Grid.Column="2" Style="{StaticResource AdvancedSegmentShell}">
                                    <UniformGrid Columns="2">
                                        <RadioButton x:Name="AdvancedToggleMode" GroupName="ActivationMode" Style="{StaticResource AdvancedSegment}" Content="Toggle" IsChecked="True" Checked="AdvancedSetting_Changed" />
                                        <RadioButton x:Name="AdvancedHoldMode" GroupName="ActivationMode" Style="{StaticResource AdvancedSegment}" Content="Hold" Checked="AdvancedSetting_Changed" />
                                    </UniformGrid>
                                </Border>
                            </Grid>

                            <TextBlock Grid.Row="6" Text="Mouse Button" Foreground="#BFC0C5" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Border Grid.Row="6" Grid.Column="1" Style="{StaticResource AdvancedSegmentShell}">
                                <UniformGrid Columns="3">
                                    <RadioButton x:Name="AdvancedMouseLeft" GroupName="MouseButton" Style="{StaticResource AdvancedSegment}" Content="Left" IsChecked="True" Checked="AdvancedSetting_Changed" />
                                    <RadioButton x:Name="AdvancedMouseMiddle" GroupName="MouseButton" Style="{StaticResource AdvancedSegment}" Content="Middle" Checked="AdvancedSetting_Changed" />
                                    <RadioButton x:Name="AdvancedMouseRight" GroupName="MouseButton" Style="{StaticResource AdvancedSegment}" Content="Right" Checked="AdvancedSetting_Changed" />
                                </UniformGrid>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Height="52" Margin="0,9,0,0" Style="{StaticResource AdvancedCard}">
                        <Grid Margin="10,7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="90" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Click Duration" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                            <Grid Grid.Column="1">
                                <TextBox x:Name="AdvancedClickDurationBox" Style="{StaticResource AdvancedField}" Text="15" Padding="8,0,22,0" PreviewTextInput="NumberOnly_PreviewTextInput" TextChanged="AdvancedSetting_Changed" />
                                <TextBlock Text="%" Margin="0,0,9,0" Foreground="#AFAFB4" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" IsHitTestVisible="False" />
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Height="91" Margin="0,9,0,0" Style="{StaticResource AdvancedCard}">
                        <Grid Margin="10,7">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="24" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Limits" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                                <Border Width="86" Height="30" HorizontalAlignment="Right" Style="{StaticResource AdvancedSegmentShell}">
                                    <UniformGrid Columns="2">
                                        <RadioButton x:Name="AdvancedLimitOff" GroupName="LimitEnabled" Style="{StaticResource AdvancedSegment}" Content="Off" IsChecked="True" Checked="AdvancedSetting_Changed" />
                                        <RadioButton x:Name="AdvancedLimitOn" GroupName="LimitEnabled" Style="{StaticResource AdvancedSegment}" Content="On" Checked="AdvancedSetting_Changed" />
                                    </UniformGrid>
                                </Border>
                            </Grid>
                            <Grid Grid.Row="1" Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="112" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="AdvancedLimitValueBox" Grid.Column="0" Style="{StaticResource AdvancedField}" Text="1000" IsEnabled="{Binding IsChecked, ElementName=AdvancedLimitOn}" PreviewTextInput="IntegerOnly_PreviewTextInput" TextChanged="AdvancedSetting_Changed" />
                                <Border Grid.Column="2" Style="{StaticResource AdvancedSegmentShell}" IsEnabled="{Binding IsChecked, ElementName=AdvancedLimitOn}">
                                    <UniformGrid Columns="2">
                                        <RadioButton x:Name="AdvancedLimitClicks" GroupName="LimitType" Style="{StaticResource AdvancedSegment}" Content="Clicks" IsChecked="True" Checked="AdvancedSetting_Changed" />
                                        <RadioButton x:Name="AdvancedLimitTime" GroupName="LimitType" Style="{StaticResource AdvancedSegment}" Content="Time" Checked="AdvancedSetting_Changed" />
                                    </UniformGrid>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Height="52" Margin="0,9,0,0" Style="{StaticResource AdvancedCard}">
                        <Grid Margin="10,7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="78" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="86" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Speed Variation" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                            <Grid Grid.Column="1">
                                <TextBox x:Name="AdvancedVariationBox" Style="{StaticResource AdvancedField}" Text="10" Padding="8,0,22,0" IsEnabled="{Binding IsChecked, ElementName=AdvancedVariationOn}" PreviewTextInput="NumberOnly_PreviewTextInput" TextChanged="AdvancedSetting_Changed" />
                                <TextBlock Text="%" Margin="0,0,9,0" Foreground="#AFAFB4" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" IsHitTestVisible="False" />
                            </Grid>
                            <Border Grid.Column="3" Style="{StaticResource AdvancedSegmentShell}">
                                <UniformGrid Columns="2">
                                    <RadioButton x:Name="AdvancedVariationOff" GroupName="VariationEnabled" Style="{StaticResource AdvancedSegment}" Content="Off" IsChecked="True" Checked="AdvancedSetting_Changed" />
                                    <RadioButton x:Name="AdvancedVariationOn" GroupName="VariationEnabled" Style="{StaticResource AdvancedSegment}" Content="On" Checked="AdvancedSetting_Changed" />
                                </UniformGrid>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Height="52" Margin="0,9,0,0" Style="{StaticResource AdvancedCard}">
                        <Grid Margin="10,7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="78" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="86" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Double Click" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                            <Grid Grid.Column="1">
                                <TextBox x:Name="AdvancedDoubleClickBox" Style="{StaticResource AdvancedField}" Text="50" Padding="8,0,18,0" IsEnabled="{Binding IsChecked, ElementName=AdvancedDoubleOn}" PreviewTextInput="IntegerOnly_PreviewTextInput" TextChanged="AdvancedSetting_Changed" />
                                <TextBlock Text="ms" Margin="0,0,7,0" Foreground="#AFAFB4" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" IsHitTestVisible="False" />
                            </Grid>
                            <Border Grid.Column="3" Style="{StaticResource AdvancedSegmentShell}">
                                <UniformGrid Columns="2">
                                    <RadioButton x:Name="AdvancedDoubleOff" GroupName="DoubleClickEnabled" Style="{StaticResource AdvancedSegment}" Content="Off" IsChecked="True" Checked="AdvancedSetting_Changed" />
                                    <RadioButton x:Name="AdvancedDoubleOn" GroupName="DoubleClickEnabled" Style="{StaticResource AdvancedSegment}" Content="On" Checked="AdvancedSetting_Changed" />
                                </UniformGrid>
                            </Border>
                        </Grid>
                    </Border>
                </StackPanel>

                <Border Grid.Column="2" Style="{StaticResource AdvancedCard}">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30" />
                            <RowDefinition Height="2" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="34" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Sequence Clicking" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                            <Border Width="86" Height="30" HorizontalAlignment="Right" Style="{StaticResource AdvancedSegmentShell}">
                                <UniformGrid Columns="2">
                                    <RadioButton x:Name="AdvancedSequenceOff" GroupName="SequenceEnabled" Style="{StaticResource AdvancedSegment}" Content="Off" IsChecked="True" Checked="AdvancedSetting_Changed" />
                                    <RadioButton x:Name="AdvancedSequenceOn" GroupName="SequenceEnabled" Style="{StaticResource AdvancedSegment}" Content="On" Checked="AdvancedSetting_Changed" />
                                </UniformGrid>
                            </Border>
                        </Grid>
                        <Border Grid.Row="1" Height="2" Background="#303034" />
                        <Button Grid.Row="3" Style="{StaticResource AdvancedAction}" Content="Add Current Cursor" Click="AddCursorPoint_Click" />
                        <Border Grid.Row="5" Background="#000000" BorderBrush="#29292D" BorderThickness="2" CornerRadius="7">
                            <Grid>
                                <ListBox x:Name="SequencePointsList" Background="Transparent" BorderThickness="0" Foreground="#D7D7DA" Padding="8" ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollBarVisibility="Hidden">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#303034" BorderThickness="0,0,0,1" Padding="8">
                                                <TextBlock Text="{Binding}" FontSize="13" />
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock x:Name="SequenceEmptyText" Text="No sequence points saved yet." Foreground="#707078" FontSize="13" Margin="12" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False" />
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
            <Grid x:Name="SettingsView" Grid.Row="1" Visibility="Collapsed" />
        </Grid>
    </Border>
</Window>
